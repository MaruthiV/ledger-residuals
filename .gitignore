# ─────────────────────────────────────────────────────────────
# PRIVATE planning / research / Claude-generated notes — NEVER push.
# Everything in docs/ (HANDOFF, CLAUDE, TASKS, research_plan,
# literature_review, research_idea, figures-planning, etc.) stays local.
# ─────────────────────────────────────────────────────────────
docs/

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.ipynb_checkpoints/
.python-version
.pytest_cache/

# ── Virtual environments ──
.venv/
venv/
env/

# ── ML artifacts: data, checkpoints, logs (regenerable / large) ──
# Anchored to repo root with leading "/" so they do NOT shadow the source
# package src/ledger/data/ (an unanchored `data/` ignores the code too).
/data/
/datasets/
/checkpoints/
/ckpts/
/outputs/
/runs/
/logs/
/wandb/
*.pt
*.ckpt
*.safetensors
*.npy
*.npz
*.bin

# ── Compiled paper / PDFs (paper itself lives in private docs/; keep all PDFs local) ──
*.pdf

# ── Modal ──
.modal/

# ── Secrets / env ──
.env
*.key

# ── OS / editor ──
.DS_Store
*.swp
.idea/
.vscode/
